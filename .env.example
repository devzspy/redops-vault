# Copy this file to .env and fill in real values. Never commit .env.

# Flask session/signing secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# JWT signing secret (can be the same as SECRET_KEY or a separate value).
JWT_SECRET_KEY=change-me-too

# Set to "true" only when serving over HTTPS. Keep "false" for local http development.
JWT_COOKIE_SECURE=false

# Postgres connection string. `docker compose up -d` starts a matching local
# instance (see docker-compose.yml for the default user/password/db).
DATABASE_URL=postgresql://redops:redops@localhost:5432/redops_vault

# Path to the SQLite database file, relative to the instance folder. Only
# used as a fallback when DATABASE_URL is unset -- not intended for real
# installs (see README.md), just for running the test suite without Docker.
DATABASE_FILENAME=redops_vault.db

# Flask environment: "development" or "production"
FLASK_ENV=development
